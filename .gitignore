# 平文でAPIキー等を含む設定・実データ(このソフト実行時に自動生成される)
config.json
shuujuku_stock.json
word_stock.json
card_defs.json
daily_pending_exclusions.json
grammar_multi_stock.json
tab_notes_state.json

# サービスアカウントJSONキー等の認証情報(万一このフォルダに置かれても除外)
*serviceaccount*.json
*service-account*.json
*credentials*.json
*-key.json

# 生成物(個人の学習内容が含まれるため、ソースではなく成果物として除外)
*.apkg
*.row_map.json
backup/
pending_decks/
output/

# Anki作業用コレクション(実行時に一時生成)
*.anki2
*.anki2-journal
*.anki2-wal
*.anki2-shm

# Python
__pycache__/
*.pyc

# ビルド成果物(PyInstaller)
build/
dist/

# エディタ・ツール固有のローカル設定
.claude/settings.local.json
