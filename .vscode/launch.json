{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ANKI出力ツール (デバッグ)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tts_gui.py",
      "python": "C:\\Python314\\python.exe",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "ANKI出力ツール Web版 (Edge)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:8000",
      "webRoot": "${workspaceFolder}/docs",
      "preLaunchTask": "Web版: ローカルサーバー起動"
    },
    {
      "name": "ANKI出力ツール Web版 (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:8000",
      "webRoot": "${workspaceFolder}/docs",
      "preLaunchTask": "Web版: ローカルサーバー起動"
    }
  ]
}
